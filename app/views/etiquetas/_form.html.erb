<%= simple_form_for(@etiqueta, html: { class: "mt-4" }) do |f| %>
  <%= render "shared/error_messages", object: @etiqueta %>

  <%= f.input :data_emissao, as: :string, input_html: { type: "date" } %>
  <%= f.input :tipo, collection: TipoEtiqueta.to_a, prompt: "Selecione o tipo" %>
  <%= f.input :quantidade, as: :integer %>
  <%= f.input :isento, as: :boolean, label: "Isento de emolumentos" %>

  <h5>Partes</h5>
  <div id="partes">
    <%= f.simple_fields_for :partes do |parte_form| %>
      <%= render "parte_fields", f: parte_form %>
    <% end %>
  </div>

  <button type="button" id="add-parte" class="btn btn-primary mb-3">Adicionar Parte</button>

  <div class="mt-3">
    <%= f.button :submit, class: "btn btn-success" %>
  </div>
<% end %>


<script>
document.addEventListener("turbo:load", () => {
  const partesDiv = document.getElementById("partes");
  const addButton = document.getElementById("add-parte");

  if (!partesDiv || !addButton) return;

  // Remove listeners antigos
  const newAddButton = addButton.cloneNode(true);
  addButton.parentNode.replaceChild(newAddButton, addButton);

  // Adicionar nova parte
  newAddButton.addEventListener("click", () => {
    const index = partesDiv.querySelectorAll(".parte-fields").length;

    const template = `
      <div class="row mb-2 parte-fields">
        <div class="col-md-5">
          <input type="text"
                 name="etiqueta[partes_attributes][${index}][nome]"
                 placeholder="Nome"
                 class="form-control"
                 aria-label="Nome" />
        </div>
        <div class="col-md-4">
          <input type="text"
                 name="etiqueta[partes_attributes][${index}][cpf]"
                 placeholder="CPF"
                 class="form-control"
                 aria-label="CPF" />
        </div>
        <div class="col-md-3">
          <button type="button" class="btn btn-danger remove-parte">Remover</button>
        </div>
      </div>
    `;
    partesDiv.insertAdjacentHTML("beforeend", template);
  });

  // Remover parte
  partesDiv.addEventListener("click", (e) => {
    if (e.target.classList.contains("remove-parte")) {
      e.target.closest(".parte-fields").remove();
    }
  });

  // Máscara de CPF
  function formatCPF(value) {
    value = value.replace(/\D/g, "");
    value = value.replace(/(\d{3})(\d)/, "$1.$2");
    value = value.replace(/(\d{3})(\d)/, "$1.$2");
    value = value.replace(/(\d{3})(\d{1,2})$/, "$1-$2");
    return value;
  }

  partesDiv.addEventListener("input", (e) => {
    if (e.target.matches("input[name*='cpf']")) {
      e.target.value = formatCPF(e.target.value);
    }
  });
});
</script>
