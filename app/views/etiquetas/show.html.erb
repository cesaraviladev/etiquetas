<div class="container py-2">
  <h1>Impressão da Etiqueta</h1>

  <% @etiquetas_para_imprimir.each do |grupo| %>
    <div class="border p-3 mb-3" style="width: 300px;">
      <%= show_for @etiqueta do |s| %>
        <%= s.attribute :tipo %>

        <%= s.attribute :data_emissao, label: "Data de emissão" do %>
          <%= @etiqueta.data_emissao.strftime("%d/%m/%Y") %>
        <% end %>

        <%= s.attribute :isento, label: "Emolumentos" do %>
          <%= @etiqueta.isento ? "Isento de emolumentos" : "Emolumento cobrado" %>
        <% end %>
      <% end %>

      <% grupo.each do |nome| %>
        <p><%= nome %></p>
      <% end %>
    </div>
  <% end %>

  <%= link_to "Voltar", etiquetas_path, class: "btn btn-secondary" %>
</div>
