<div class="d-flex justify-content-center align-items-center min-vh-100">
  <div class="card shadow-lg p-4" style="max-width: 400px; width: 100%;">
    <h2 class="card-title text-center mb-4">Registrar Usuário</h2>

    <%= form_for(resource, as: resource_name, url: registration_path(resource_name)) do |f| %>
      <%= devise_error_messages! %>

      <div class="mb-3">
        <%= f.label :email, class: "form-label" %>
        <%= f.email_field :email, autofocus: true, class: "form-control", placeholder: "Digite seu e-mail" %>
      </div>

      <div class="mb-3">
        <%= f.label :password, class: "form-label" %>
        <%= f.password_field :password, autocomplete: "new-password", class: "form-control", placeholder: "Senha" %>
      </div>

      <div class="mb-3">
        <%= f.label :password_confirmation, class: "form-label" %>
        <%= f.password_field :password_confirmation, class: "form-control", placeholder: "Confirme a senha" %>
      </div>

      <div class="d-grid">
        <%= f.submit "Registrar", class: "btn btn-primary btn-lg" %>
      </div>
    <% end %>

    <div class="mt-3 text-center">
      <%= link_to "Já tem conta? Entrar", new_session_path(resource_name), class: "text-decoration-none" %>
    </div>
