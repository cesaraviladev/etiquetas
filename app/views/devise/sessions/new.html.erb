<div class="container vh-100 d-flex flex-column justify-content-center align-items-center">

  <!-- Logo centralizada -->
  <div class="mb-4 text-center">
    <%= image_tag "logo_etiquetas.png", alt: "Etiquetas", style: "max-height: 100px;" %>
  </div>

  <!-- Card de login -->
  <div class="card shadow-lg p-4" style="max-width: 400px; width: 100%;">
    <h3 class="card-title text-center mb-4">Login</h3>

    <% if flash[:alert] %>
      <div class="alert alert-danger"><%= flash[:alert] %></div>
    <% end %>

    <%= form_for(resource, as: resource_name, url: session_path(resource_name)) do |f| %>
      <div class="mb-3">
        <%= f.label :email, class: "form-label" %>
        <%= f.email_field :email, autofocus: true, class: "form-control", placeholder: "Digite seu email" %>
      </div>

      <div class="mb-3">
        <%= f.label :password, class: "form-label" %>
        <%= f.password_field :password, autocomplete: "current-password", class: "form-control", placeholder: "Digite sua senha" %>
      </div>

      <% if devise_mapping.rememberable? %>
        <div class="form-check mb-3">
          <%= f.check_box :remember_me, class: "form-check-input" %>
          <%= f.label :remember_me, class: "form-check-label" %>
        </div>
      <% end %>

      <div class="d-grid">
        <%= f.submit "Entrar", class: "btn btn-primary btn-lg" %>
      </div>
    <% end %>

    <div class="d-grid mt-2">
      <%= link_to "Registrar", new_registration_path(resource_name), class: "btn btn-outline-primary btn-lg" %>
    </div>

    <div class="mt-3 text-center">
      <%= link_to "Esqueceu sua senha?", new_password_path(resource_name), class: "text-decoration-none" %>
    </div>
  </div>
</div>
